# Onion OS shipped gpSP core options (copied verbatim below).
# Source: https://raw.githubusercontent.com/OnionUI/Onion/main/static/configs/Saves/CurrentProfile/config/gpSP/gpSP.opt (fetched 2026-10-18)
gpsp_bios = "auto"
gpsp_boot_mode = "game"
gpsp_color_correction = "disabled"
gpsp_drc = "enabled"
gpsp_frame_mixing = "disabled"
gpsp_frameskip = "disabled"
gpsp_frameskip_interval = "1"
gpsp_frameskip_threshold = "33"
gpsp_save_method = "gpSP"
gpsp_turbo_period = "4"
